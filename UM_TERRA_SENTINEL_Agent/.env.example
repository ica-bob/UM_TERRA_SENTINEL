# ════════════════════════════════════════════════════════════════════
#  UM_TERRA_SENTINEL Agent — Environment Configuration Template
#  © 2026 Utsav Mukherjee <utsavmukherjee143@gmail.com>. All rights reserved.
#
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── LLM Provider (watsonx | ollama) ──────────────────────────────
LLM_PROVIDER=watsonx

# ── WatsonX credentials (required when LLM_PROVIDER=watsonx) ──────
WATSONX_APIKEY=<ENTER WATSONX API KEY>
WATSONX_URL=<ENTER WATSONX ML URL>
WATSONX_PROJECT_ID=<ENTER WATSONX PROJECT ID>
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── Ollama (alternative, required when LLM_PROVIDER=ollama) ───────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=llama3

# ── MCP Server Configuration (optional extra tool servers) ────────
# Leave blank if you are not adding extra MCP tool servers.
MCP_SERVER_NAMES=
MCP_SERVER_URLS=
MCP_SERVER_TRANSPORT=streamable-http

# ── Agent Server ──────────────────────────────────────────────────
DEFAULT_HOST=0.0.0.0
DEFAULT_PORT=8080
DEFAULT_PUBLIC_HOST=

# ── Authentication (disabled by default) ─────────────────────────
# Set ENABLE_CLIENT_AUTH=true and/or ENABLE_USER_AUTH=true to enable.
# IMPORTANT: Both IBM_TENANT_ID and IBM_INTROSPECT_URL must be set
#            when authentication is enabled, or auth will silently fail.
ENABLE_CLIENT_AUTH=false
ENABLE_USER_AUTH=false
IBM_TENANT_ID=
IBM_INTROSPECT_URL=

# ── AgentOps Observability (disabled by default) ─────────────────
# Install separately: pip install aicoe-agent-utils[agentops]
ENABLE_AGENTOPS=false
AGENTOPS_APP_NAME=UM_TERRA_SENTINEL
AGENTOPS_ENDPOINT=
